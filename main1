<!DOCTYPE html>
<html lang="tr" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mesai & Maaş Hesaplayıcı</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icon Set -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Mobil Dokunma İyileştirmeleri */
        input, select, button { touch-action: manipulation; }
    </style>
</head>
<body class="h-full flex flex-col text-slate-800">

    <!-- Header / Navbar -->
    <header class="bg-indigo-600 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-md mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i class="fa-solid me-1 fa-calculator text-2xl text-indigo-200"></i>
                <h1 class="font-bold text-xl tracking-wide">MesaiTakip</h1>
            </div>
            <button onclick="openSettingsModal()" class="p-2 rounded-full hover:bg-indigo-700 transition" title="Ayarlar">
                <i class="fa-solid fa-gear text-lg"></i>
            </button>
        </div>
    </header>

    <!-- Main Container (Mobile Max Width Container) -->
    <main class="flex-grow max-w-md w-full mx-auto p-4 space-y-4 pb-20">

        <!-- Bilgilendirme Kartı / Özet -->
        <section class="bg-gradient-to-br from-indigo-500 to-indigo-700 rounded-2xl p-5 text-white shadow-lg">
            <div class="flex justify-between items-start mb-3">
                <div>
                    <span class="text-xs uppercase tracking-wider text-indigo-200 font-semibold">Bu Ayki Toplam Mesai</span>
                    <h2 id="totalEarnings" class="text-3xl font-extrabold mt-1">₺0,00</h2>
                </div>
                <div class="bg-indigo-400/30 p-2.5 rounded-xl">
                    <i class="fa-solid fa-wallet text-2xl text-indigo-100"></i>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2 border-t border-indigo-400/30 pt-3 text-sm">
                <div>
                    <span class="text-indigo-200 text-xs">Toplam Saat:</span>
                    <p id="totalHours" class="font-bold text-base">0 Sa</p>
                </div>
                <div>
                    <span class="text-indigo-200 text-xs">Saatlik Ücret:</span>
                    <p id="hourlyRateDisplay" class="font-bold text-base">₺0,00</p>
                </div>
            </div>
        </section>

        <!-- Yeni Mesai Ekle Formu -->
        <section class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
            <h3 class="font-bold text-slate-700 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-plus-circle text-indigo-600"></i> Yeni Mesai Kaydı
            </h3>
            
            <form id="overtimeForm" onsubmit="handleFormSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Tarih</label>
                    <input type="date" id="workDate" required
                           class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Süre (Saat)</label>
                        <input type="number" step="0.5" min="0.5" max="24" id="workHours" placeholder="Örn: 2.5" required
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Mesai Tipi</label>
                        <select id="rateMultiplier" required
                                class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700">
                            <option value="1.5">Hafta İçi (%50)</option>
                            <option value="2.0">Hafta Sonu (%100)</option>
                            <option value="3.0">Resmi Tatil (%200)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Not / Açıklama (İsteğe Bağlı)</label>
                    <input type="text" id="workNote" placeholder="Örn: Proje teslimi mesaisi"
                           class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700">
                </div>

                <button type="submit"
                        class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check"></i> Mesai Kaydet
                </button>
            </form>
        </section>

        <!-- Geçmiş Mesai Listesi -->
        <section class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-bold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-indigo-600"></i> Mesai Geçmişi
                </h3>
                <button onclick="exportToCSV()" class="text-xs text-indigo-600 font-semibold hover:underline flex items-center gap-1">
                    <i class="fa-solid fa-file-csv"></i> Excel'e Aktar
                </button>
            </div>

            <div id="logsContainer" class="space-y-3 max-h-80 overflow-y-auto pr-1">
                <!-- Kayıtlar JavaScript ile yüklenecek -->
            </div>
        </section>
    </main>

    <!-- Ayarlar Modalı -->
    <div id="settingsModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl relative">
            <button onclick="closeSettingsModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-times text-xl"></i>
            </button>
            
            <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-sliders text-indigo-600"></i> Maaş & Ayarlar
            </h3>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Aylık Net Maaş (₺)</label>
                    <input type="number" id="baseSalaryInput" placeholder="Örn: 25000"
                           class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Aylık Çalışma Saati</label>
                    <input type="number" id="monthlyHoursInput" value="225" placeholder="Varsayılan: 225"
                           class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <span class="text-[11px] text-slate-400 mt-1 block">Türkiye standardı aylık 225 saattir.</span>
                </div>

                <div class="pt-2 flex gap-2">
                    <button onclick="saveSettings()" class="w-full bg-indigo-600 text-white font-semibold py-2.5 rounded-xl hover:bg-indigo-700 transition">
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bildirim Mesaj Kutusu (Alert Yerine) -->
    <div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-sm px-4 py-2.5 rounded-full shadow-lg hidden transition duration-300 z-50 flex items-center gap-2">
        <i id="toastIcon" class="fa-solid fa-circle-info"></i>
        <span id="toastMsg">İşlem Başarılı</span>
    </div>

    <!-- JS Mantığı -->
    <script>
        // Durum (State) Değişkenleri
        let state = {
            salary: parseFloat(localStorage.getItem('user_salary')) || 0,
            monthlyHours: parseFloat(localStorage.getItem('user_monthly_hours')) || 225,
            logs: JSON.parse(localStorage.getItem('overtime_logs')) || []
        };

        // Sayfa Yüklendiğinde
        window.onload = function() {
            // Tarih alanına bugünün tarihini atayalım
            document.getElementById('workDate').valueToDate = new Date();
            document.getElementById('workDate').value = new Date().toISOString().split('T')[0];
            
            // Ayar girdilerini güncelle
            document.getElementById('baseSalaryInput').value = state.salary || '';
            document.getElementById('monthlyHoursInput').value = state.monthlyHours;

            // Görünümü güncelle
            renderUI();
        };

        // Hesaplamalar
        function getHourlyRate() {
            if (!state.salary || state.salary <= 0) return 0;
            return state.salary / state.monthlyHours;
        }

        // Arayüz (UI) Güncelleme
        function renderUI() {
            const hourlyRate = getHourlyRate();
            document.getElementById('hourlyRateDisplay').textContent = formatCurrency(hourlyRate);

            // Toplamları Hesapla
            let totalHours = 0;
            let totalEarnings = 0;

            state.logs.forEach(log => {
                const hours = parseFloat(log.hours);
                const rate = parseFloat(log.rateMultiplier);
                const logEarnings = hours * hourlyRate * rate;
                
                totalHours += hours;
                totalEarnings += logEarnings;
            });

            document.getElementById('totalHours').textContent = `${totalHours} Sa`;
            document.getElementById('totalEarnings').textContent = formatCurrency(totalEarnings);

            // Kayıt Listesini Oluştur
            renderLogs(hourlyRate);
        }

        function renderLogs(hourlyRate) {
            const container = document.getElementById('logsContainer');
            container.innerHTML = '';

            if (state.logs.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-6 text-slate-400">
                        <i class="fa-regular fa-folder-open text-3xl mb-2"></i>
                        <p class="text-xs">Henüz mesai kaydı bulunmuyor.</p>
                    </div>`;
                return;
            }

            // En yeni tarihi en üstte göster
            const sortedLogs = [...state.logs].sort((a, b) => new Date(b.date) - new Date(a.date));

            sortedLogs.forEach((log) => {
                const itemEarnings = log.hours * hourlyRate * log.rateMultiplier;
                const dateFormatted = new Date(log.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' });
                
                let badgeColor = 'bg-blue-100 text-blue-700';
                let typeText = '%50';
                if(log.rateMultiplier == 2.0) { badgeColor = 'bg-amber-100 text-amber-700'; typeText = '%100'; }
                if(log.rateMultiplier == 3.0) { badgeColor = 'bg-rose-100 text-rose-700'; typeText = '%200'; }

                const div = document.createElement('div');
                div.className = "flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition";
                div.innerHTML = `
                    <div class="space-y-0.5">
                        <div class="flex items-center gap-2">
                            <span class="font-semibold text-sm text-slate-800">${dateFormatted}</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full font-bold ${badgeColor}">${typeText}</span>
                        </div>
                        <p class="text-xs text-slate-500">${log.note ? log.note : 'Açıklama yok'} • <strong>${log.hours} Saat</strong></p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="font-bold text-slate-700 text-sm">${formatCurrency(itemEarnings)}</span>
                        <button onclick="deleteLog('${log.id}')" class="text-slate-300 hover:text-rose-500 p-1 transition">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        // Form Gönderimi
        function handleFormSubmit(e) {
            e.preventDefault();

            if (!state.salary || state.salary <= 0) {
                showToast('Lütfen önce maaş bilgilerinizi ayarlardan girin!', 'warning');
                openSettingsModal();
                return;
            }

            const date = document.getElementById('workDate').value;
            const hours = parseFloat(document.getElementById('workHours').value);
            const rateMultiplier = parseFloat(document.getElementById('rateMultiplier').value);
            const note = document.getElementById('workNote').value.trim();

            const newLog = {
                id: Date.now().toString(),
                date,
                hours,
                rateMultiplier,
                note
            };

            state.logs.push(newLog);
            saveToLocalStorage();
            renderUI();

            // Form Reset
            document.getElementById('workHours').value = '';
            document.getElementById('workNote').value = '';
            
            showToast('Mesai kaydı eklendi', 'success');
        }

        // Kayıt Silme
        function deleteLog(id) {
            state.logs = state.logs.filter(log => log.id !== id);
            saveToLocalStorage();
            renderUI();
            showToast('Kayıt silindi', 'info');
        }

        // Ayarları Kaydetme
        function saveSettings() {
            const salary = parseFloat(document.getElementById('baseSalaryInput').value);
            const hours = parseFloat(document.getElementById('monthlyHoursInput').value);

            if (isNaN(salary) || salary <= 0) {
                showToast('Geçerli bir maaş girin!', 'warning');
                return;
            }

            state.salary = salary;
            state.monthlyHours = hours || 225;

            localStorage.setItem('user_salary', state.salary);
            localStorage.setItem('user_monthly_hours', state.monthlyHours);

            renderUI();
            closeSettingsModal();
            showToast('Ayarlar kaydedildi', 'success');
        }

        // CSV / Excel Dışa Aktar
        function exportToCSV() {
            if (state.logs.length === 0) {
                showToast('Dışa aktarılacak kayıt bulunmuyor!', 'warning');
                return;
            }

            const hourlyRate = getHourlyRate();
            let csvContent = "data:text/csv;charset=utf-8,\uFEFF Tarih,Sure (Saat),Mesai Orani,Aciklama,Tutar (TL)\n";

            state.logs.forEach(log => {
                const amount = (log.hours * hourlyRate * log.rateMultiplier).toFixed(2);
                csvContent += `"${log.date}","${log.hours}","%${(log.rateMultiplier-1)*100}","${log.note || ''}","${amount}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Mesai_Raporu_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // LocalStorage İşlemleri
        function saveToLocalStorage() {
            localStorage.setItem('overtime_logs', JSON.stringify(state.logs));
        }

        // Yardımcı Fonksiyonlar
        function formatCurrency(val) {
            return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(val);
        }

        function openSettingsModal() {
            document.getElementById('settingsModal').classList.remove('hidden');
            document.getElementById('settingsModal').classList.add('flex');
        }

        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.add('hidden');
            document.getElementById('settingsModal').classList.remove('flex');
        }

        function showToast(msg, type = 'info') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.textContent = msg;

            if (type === 'warning') {
                toastIcon.className = "fa-solid fa-triangle-exclamation text-amber-400";
            } else if (type === 'success') {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-indigo-400";
            }

            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }
    </script>
</body>
</html>
